{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2018",
    "lib": ["DOM", "ES2018", "ES2019", "ES2020", "ES2021"],
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "importHelpers": true
  },
  "include": ["src/**/*.ts"]
}
